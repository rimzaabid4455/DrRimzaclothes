MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/rasdb?retryWrites=true&w=majority
JWT_SECRET=replace_with_long_random_string
PORT=5000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123

# Optional: comma-separated list of allowed origins (production)
# Example: https://ras-frontend.vercel.app,https://ras-admin.vercel.app
CORS_ORIGINS=

# Optional: force Google DNS (only set to "true" if local DNS blocks Mongo SRV lookup)
FORCE_DNS=
